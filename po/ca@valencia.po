msgstr "En pausa: %s. Executa \"%s on\" per a reprendre'l."

#: ../eduwifi-watchdog.sh:263
msgid "Wi-Fi OK, nothing to do"
msgstr "Wi-Fi correcta, no cal fer res"

#: ../eduwifi-watchdog.sh:269
msgid "Wi-Fi not responding (failure %s/%s), waiting for the next check"
msgstr "La Wi-Fi no respon (fallada %s/%s), s'espera a la pròxima comprovació"

#: ../eduwifi-watchdog.sh:274
msgid "Recovered at level 1"
msgstr "Recuperada en el nivell 1"

#: ../eduwifi-watchdog.sh:280
