#: ../eduwifi-watchdog.sh:285
msgid "Recovered at level 2 (module reload)"
msgstr "Recuperada en el nivell 2 (recàrrega del mòdul)"

#: ../eduwifi-watchdog.sh:288
msgid "Recovered at level 3 (USB reset)"
msgstr "Recuperada en el nivell 3 (reinici USB)"

#: ../eduwifi-watchdog.sh:291
msgid "Could not recover the Wi-Fi; the adapter must be unplugged physically"
msgstr ""
"No s'ha pogut recuperar la Wi-Fi; cal desconnectar físicament l'adaptador"

#: ../eduwifi-watchdog.sh:298
msgid "Interface:     %s (%s)"
msgstr "Interfície:    %s (%s)"

#: ../eduwifi-watchdog.sh:298
