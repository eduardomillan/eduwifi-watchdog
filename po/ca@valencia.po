msgstr "(cap)"

#: ../eduwifi-watchdog.sh:314
msgid "Latest events:"
msgstr "Últims esdeveniments:"

#: ../eduwifi-watchdog.sh:320
msgid ""
"Disconnected manually by %s; the watchdog will not reconnect until \"on\""
msgstr ""
"Desconnectada manualment per %s; el vigilant no la tornarà a connectar fins "
