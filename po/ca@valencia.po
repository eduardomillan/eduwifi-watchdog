msgstr "Consulta: journalctl -t %s --since \"@%s\""

#: ../eduwifi-watchdog.sh:430
msgid "Watchdog paused: %s"
msgstr "Vigilant en pausa: %s"

#: ../eduwifi-watchdog.sh:433
msgid "Wi-Fi connected to \"%s\". Watchdog active."
msgstr "Wi-Fi connectada a \"%s\". Vigilant actiu."

#: ../eduwifi-watchdog.sh:435
msgid "Wi-Fi not connected. The watchdog will try to recover it."
msgstr "Wi-Fi no connectada. El vigilant intentarà recuperar-la."

#: ../eduwifi-watchdog.sh:445 ../eduwifi-watchdog.sh:446
msgid "Wi-Fi status"
msgstr "Estat de la Wi-Fi"

#: ../eduwifi-watchdog.sh:454
msgid "Wi-Fi turned off. It will stay off until you turn it on again."
msgstr "Wi-Fi apagada. Continuarà apagada fins que la tornes a encendre."

#: ../eduwifi-watchdog.sh:456
msgid "Could not turn the Wi-Fi off."
msgstr "No s'ha pogut apagar la Wi-Fi."

#: ../eduwifi-watchdog.sh:461
msgid "Turning the Wi-Fi on and connecting..."
msgstr "S'està encenent la Wi-Fi i connectant..."

#: ../eduwifi-watchdog.sh:463
msgid "Wi-Fi connected to \"%s\"."
msgstr "Wi-Fi connectada a \"%s\"."

#: ../eduwifi-watchdog.sh:465
msgid "The Wi-Fi is on but not connected yet. The watchdog will keep trying."
msgstr ""
"La Wi-Fi està encesa però encara no està connectada. El vigilant continuarà "
"intentant-ho."

#: ../eduwifi-watchdog.sh:472
msgid "The Wi-Fi is paused. Use \"Turn Wi-Fi on\" instead."
msgstr "La Wi-Fi està en pausa. Usa «Encén la Wi-Fi»."

#: ../eduwifi-watchdog.sh:475
msgid "Recovering the Wi-Fi. This may take up to a minute..."
msgstr "S'està recuperant la Wi-Fi. Pot tardar fins a un minut..."

#: ../eduwifi-watchdog.sh:479
msgid "Wi-Fi recovered."
msgstr "Wi-Fi recuperada."

#: ../eduwifi-watchdog.sh:480
msgid "Recovery cancelled: administrator authorization is required."
msgstr "S'ha cancel·lat la recuperació: cal l'autorització de l'administrador."

#: ../eduwifi-watchdog.sh:481
msgid "Could not recover the Wi-Fi. Unplug the adapter and plug it in again."
msgstr ""
"No s'ha pogut recuperar la Wi-Fi. Desconnecta l'adaptador i torna'l a "
