#: ../eduwifi-watchdog.sh:196
msgid "Level 1: connecting %s to \"%s\""
msgstr "Nivell 1: es connecta %s a \"%s\""

#: ../eduwifi-watchdog.sh:206
msgid "Level 2: no MODULE configured, skipping"
msgstr "Nivell 2: no hi ha MODULE configurat, s'omet"

#: ../eduwifi-watchdog.sh:209
msgid "Level 2: reloading kernel module %s"
msgstr "Nivell 2: es recarrega el mòdul del nucli %s"

#: ../eduwifi-watchdog.sh:212
