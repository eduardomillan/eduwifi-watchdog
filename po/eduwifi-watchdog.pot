#: ../install.sh:34
msgid ""
"Usage: sudo %s [options]\n"
"\n"
"Installs eduwifi-watchdog, enables its systemd timer and adds a menu entry.\n"
"Requires root. Without options it asks for the settings interactively.\n"
"\n"
"Options:\n"
"  --networks \"Net1,Net2\"   NetworkManager profiles to retry, comma-"
"separated,\n"
"                           in priority order (skips the networks question)\n"
"  --uninstall              Remove the script, the systemd units, the menu "
"entry\n"
"                           and the translations (keeps %s)\n"
"  -h, --help               Show this help"
msgstr ""

